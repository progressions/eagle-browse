#!/usr/bin/env bash
# Headless inbox consumer for Eagle Browse (no GTK UI).
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
ROOT="$DIR"
LAUNCHER="$ROOT/$(basename "$SOURCE")"
export EAGLE_LIBRARY="${EAGLE_LIBRARY:-$HOME/Dropbox/ISAAC/GENNIE/Eunbi.library}"
export EAGLE_INBOX="${EAGLE_INBOX:-$HOME/Dropbox/ISAAC/GENNIE/Eunbi/PICS/Eunbi}"

# shellcheck source=self_update.sh
source "$ROOT/self_update.sh"
eagle_browse_self_update "$LAUNCHER" "$@"
eagle_browse_filter_args "$@"

exec python3 "$DIR/inbox_watch.py" "${EAGLE_BROWSE_ARGS[@]}"
