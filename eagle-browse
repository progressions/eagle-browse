#!/usr/bin/env bash
# Launch Eagle Browse against your Dropbox library (override with EAGLE_LIBRARY).
set -euo pipefail
# Resolve symlinks so ~/.local/bin/eagle-browse still finds app.py
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
ROOT="$DIR"
LAUNCHER="$ROOT/$(basename "$SOURCE")"
export EAGLE_LIBRARY="${EAGLE_LIBRARY:-$HOME/Dropbox/ISAAC/GENNIE/Eunbi.library}"

# shellcheck source=self_update.sh
source "$ROOT/self_update.sh"
eagle_browse_self_update "$LAUNCHER" "$@"
eagle_browse_filter_args "$@"

exec python3 "$DIR/app.py" "${EAGLE_BROWSE_ARGS[@]}"
