# Copy to the vault root (next to Eunbi.library) as eagle-browse.toml,
# or to ~/.config/eagle-browse/config.toml for a per-machine overlay.
#
# Relative paths are resolved from this file's directory.
# Env overrides: EAGLE_INBOX, EAGLE_LIBRARY, EAGLE_BROWSE_CONFIG

inbox = "intake"
library = "Eunbi.library"

# Recursively import media in intake subfolders into Eagle categories.
# The first directory supplies the category: video/dance/clip.mp4 -> video.
# Names match case-insensitively; new categories use lowercase names.
inbox_subfolders_as_categories = false
