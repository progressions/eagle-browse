[Unit]
Description=Eagle phone browse (LAN server for mobile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Port 8788 on Ginger — 8787 is the Eunbi communicator dashboard (localhost).
ExecStart=/usr/bin/phone-browse --port 8788
Restart=on-failure
RestartSec=5
EnvironmentFile=-%h/.config/eagle-browse/environment

[Install]
WantedBy=default.target
