#!/usr/bin/env bash
# Launch the Eagle phone browser (LAN server).
set -euo pipefail
# Resolve symlinks so ~/.local/bin/phone-browse still finds phone_server.py
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")" && pwd)"
LAUNCHER="$ROOT/$(basename "$SOURCE")"

# shellcheck source=self_update.sh
source "$ROOT/self_update.sh"
eagle_browse_self_update "$LAUNCHER" "$@"
eagle_browse_filter_args "$@"

exec python3 "$ROOT/phone_server.py" "${EAGLE_BROWSE_ARGS[@]}"
