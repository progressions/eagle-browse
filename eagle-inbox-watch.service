[Unit]
Description=Eagle Browse headless inbox importer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/eagle-inbox-watch --dup=reuse
Restart=on-failure
RestartSec=5
# Dropbox may lag after login.
# Inbox path is read from the vault eagle-browse.toml (not hardcoded here).
EnvironmentFile=-%h/.config/eagle-browse/environment

[Install]
WantedBy=default.target
