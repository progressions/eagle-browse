[Unit]
Description=Eagle Browse headless inbox importer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/eagle-inbox-watch --dup=reuse
Restart=on-failure
RestartSec=5
# Dropbox may lag after login.
# Inbox path is read from the vault eagle-browse.toml (not hardcoded here).
Environment=EAGLE_LIBRARY=%h/Dropbox/ISAAC/GENNIE/Eunbi.library

[Install]
WantedBy=default.target
